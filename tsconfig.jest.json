{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    /* `isolatedModules: true` membuat ts-jest memakai transpileModule: tiap
     * berkas dikompilasi sendiri-sendiri tanpa membangun program TypeScript.
     *
     * Semula ini WAJIB, bukan pilihan: dua barrel (features/dashboard dan
     * features/issues) melakukan `export { X } from './index.tsx'` dengan
     * ekstensi eksplisit, yang gagal diresolusi program penuh sehingga ts-jest
     * menerima output kosong. Kedua barrel itu sudah dirapikan, jadi alasan
     * asalnya tidak berlaku lagi.
     *
     * Setelan ini tetap dipertahankan karena manfaat keduanya: seluruh suite
     * turun dari 63 detik menjadi sekitar 6 detik. Type-check tidak hilang —
     * `npm run lint` menjalankan `tsc --noEmit` atas seluruh proyek. Jest
     * menguji perilaku, tsc menjaga tipe. */
    "isolatedModules": true
  }
}
