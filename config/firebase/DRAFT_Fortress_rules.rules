rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Primitives ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // --- Validation Helpers ---
    function isValidUser(data) {
        return data.username is string && data.username.size() <= 100
            && data.role is string
            && data.status is string;
    }

    function isValidProject(data) {
        return data.name is string && data.name.size() <= 100
            && data.ownerId is string && data.ownerId.size() <= 128;
    }

    function isValidTask(data) {
        return data.projectId is string && data.title is string && data.title.size() <= 500
            && (data.assigneeId is string || data.assigneeId == null)
            && data.status is string;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Match Blocks ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && request.auth.uid == userId 
                    && isValidUser(incoming())
                    && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      
      match /notifications/{notificationId} {
         allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && (exists(/databases/$(database)/documents/users/$(request.auth.uid)) || isAdmin());
      
      allow update: if isSignedIn() 
                    && isValidProject(incoming())
                    && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && isValidTask(incoming()) && isValidId(projectId) && isValidId(taskId);
      }
    }
  }
}
